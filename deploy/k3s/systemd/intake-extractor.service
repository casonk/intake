[Unit]
Description=Forward loopback to the intake extractor pod's ClusterIP
Requires=intake-extractor.socket
After=intake-extractor.socket
# A burst of documents is many short connections; never let the start-rate limit take the port down.
StartLimitIntervalSec=0

[Service]
# No --exit-idle-time: the forwarder stays up. (=0 meant "exit as soon as idle", one start per connection.)
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 10.43.0.61:5455
PrivateTmp=yes
