receipt_dir = "/mnt/setup/bully/info/receipt"
db_path = "data/intake.db"
reports_dir = "reports"

# ── OpenAI fallback (optional) ────────────────────────────────────────────────
# Two-tier model config:
#   low  — used when OCR quality is borderline (short text, missing total/vendor)
#   high — used when the extracted merchant name matches an escalation pattern
#          (e.g. a date fragment or page number ended up as the vendor name)
#
# Model rank (higher = more capable):  gpt-4o > gpt-4o-mini > tesseract
# Backfill re-processes any receipt whose sidecar model rank < current high model.
#
# Preferred: resolve the API key from KeePassXC via auto-pass:
#   openai_api_key_entry = "api/openai"   # KeePass entry path; Password field used
#
# Fallback: set the key directly (not recommended — keep secrets out of config):
#   openai_api_key = "sk-..."
#
# openai_model_low  = "gpt-4o-mini"   # borderline OCR quality
# openai_model_high = "gpt-4o"        # confirmed bad extraction / escalation

# ── Escalation patterns ───────────────────────────────────────────────────────
# Regex patterns matched against the extracted merchant name.  Any match forces
# the high-fidelity model regardless of overall OCR quality.
# Defaults are applied when this list is absent.
#
# escalation_patterns = [
#   "\\d{1,2}[/\\-]\\d{1,2}",   # date fragment in name: "03/15"
#   "\\bpages?\\s*\\.?\\s*\\d+\\b",  # "page 1"
#   "\\bpg\\.?\\s*\\d+\\b",     # "pg. 2"
#   "#\\d{3,}",                  # receipt number: "#00123"
#   "^\\d+$",                    # name is all digits
#   "^.{0,2}$",                  # name is 0–2 chars
# ]

# ── Fuzzy merchant correction ─────────────────────────────────────────────────
# After OCR, merchant names are fuzzy-matched against known keywords.
# Raise the threshold (max 1.0) to be more conservative; lower it to correct
# more aggressively.  Keywords shorter than 4 chars are always skipped.
#
# fuzzy_threshold = 0.82

# ── Email receipt ingestion (optional) ───────────────────────────────────────
# Fetches receipt emails from Gmail via IMAP using shock-relay.
# Run: intake email fetch       (one-shot)
#      intake email daemon       (continuous polling)
#      intake email status       (show stats)
#
# [email]
# shock_relay_config = "/path/to/shock-relay/services/gmail-imap/config.local.yaml"
#
# # Gmail label to move processed emails into (created automatically if absent)
# processed_label = "intake/processed"
#
# # Subject keywords — any match triggers fetch (case-insensitive)
# receipt_subjects = [
#   "receipt",
#   "invoice",
#   "order confirmation",
#   "your order",
#   "order #",
# ]
#
# # How far back to search on each run (days)
# since_days = 90
#
# # Daemon polling interval (seconds)
# poll_interval_seconds = 300
#
# # Max emails to process per run
# limit = 500


