receipt_dir = "/mnt/snowbridge/receipts"
db_path = "data/intake.db"
reports_dir = "reports"

# Keep intake-wide settings at the top level of this file.
# Do not create a separate config/auto-pass.ini.
# Do not place openai_* / auto_pass_profile / fuzzy_threshold after a table
# header like [web] or [email]; in TOML, those keys would belong to that table
# and intake would no longer see them as global settings.

# ── Local report web server (optional) ───────────────────────────────────────
# Serves the generated HTML/Markdown reports on localhost so wiring-harness can
# terminate mTLS and proxy them as an internal site.
#
# [web]
# host = "127.0.0.1"
# port = 5200

# ── Report links (optional) ──────────────────────────────────────────────────
# By default reports link into the Snowbridge File Browser so folder/file links
# work from the served HTML site as well as the Markdown output.
#
# [report_links]
# filebrowser_base_url = "https://files.snowbridge.internal"
# filebrowser_receipt_root = "receipt"
#
# Set filebrowser_base_url = "" to disable browser links entirely.

# ── OpenAI fallback (optional) ────────────────────────────────────────────────
# Two-tier model config:
#   low  — used when OCR quality is borderline (short text, missing total/vendor)
#   high — used when the extracted merchant name matches an escalation pattern
#          (e.g. a date fragment or page number ended up as the vendor name),
#          or when the OCR-parsed total crosses the high-total guard below
#
# Model rank (higher = more capable):  gpt-4o > gpt-4o-mini > tesseract
# Backfill re-processes any receipt whose sidecar model rank < current high model.
#
# Preferred: resolve the API key from KeePassXC via auto-pass directly from
# this file:
#   auto_pass_profile = "your-profile"             # optional auto-pass profile override
#   openai_api_key_entry = "vendor/openai/api-key"        # Password field used
#
# Fallback: set the key directly (not recommended — keep secrets out of config):
#   openai_api_key = "sk-..."
#
# openai_model_low  = "gpt-4o-mini"   # borderline OCR quality
# openai_model_mid  = "gpt-4o"        # blacklisted purchaser detected by low model
# openai_model_high = "gpt-4.1"       # confirmed bad extraction / escalation
#
# total_escalation_threshold = 250.0   # set to 0 to disable high-total escalation

# ── Non-English OCR translation (defaults to local Ollama) ───────────────────
# For receipts whose OCR is not primarily English, intake stores:
#   - raw_text / *.ocr.txt        → original OCR
#   - translated_text             → line-faithful English translation
#
# By default this uses the shared local crew-chief/Ollama service to avoid API
# usage. Set translation_provider = "none" to disable translation persistence.
#
# translation_provider = "ollama"
# translation_model = "aya-expanse:8b"
# translation_base_url = "http://localhost:11434"
# translation_timeout_seconds = 60

# ── Escalation patterns ───────────────────────────────────────────────────────
# Regex patterns matched against the extracted merchant name.  Any match forces
# the high-fidelity model regardless of overall OCR quality.
# Defaults are applied when this list is absent.
#
# escalation_patterns = [
#   "\\d{1,2}[/\\-]\\d{1,2}",   # date fragment in name: "03/15"
#   "\\bpages?\\s*\\.?\\s*\\d+\\b",  # "page 1"
#   "\\bpg\\.?\\s*\\d+\\b",     # "pg. 2"
#   "#\\d{3,}",                  # receipt number: "#00123"
#   "^\\d+$",                    # name is all digits
#   "^.{0,2}$",                  # name is 0–2 chars
# ]

# ── Fuzzy merchant correction ─────────────────────────────────────────────────
# After OCR, merchant names are fuzzy-matched against known keywords.
# Raise the threshold (max 1.0) to be more conservative; lower it to correct
# more aggressively.  Keywords shorter than 4 chars are always skipped.
#
# fuzzy_threshold = 0.82

# ── Email receipt ingestion (optional) ───────────────────────────────────────
# Fetches receipt emails from Gmail via IMAP using shock-relay.
# Run: intake email fetch       (one-shot)
#      intake email daemon       (continuous polling)
#      intake email status       (show stats)
#
# [email]
# shock_relay_config = "/path/to/shock-relay/services/gmail-imap/config.local.yaml"
#
# # Gmail label to move processed emails into (created automatically if absent)
# processed_label = "intake/processed"
#
# # Gmail label used for intake-generated notification emails.
# notification_label = "intake/notify"
#
# # Intake leaves its own notification emails untouched in INBOX long enough for
# # Gmail/device notifications to fire, then files them into notification_label
# # on a later poll. Set to 0 to file immediately.
# notification_inbox_grace_minutes = 60
#
# # Subject keywords — any match triggers fetch (case-insensitive)
# receipt_subjects = [
#   "receipt",
#   "invoice",
#   "order confirmation",
#   "your order",
#   "order #",
#   "we've received your payment",
#   "your payment of",
#   # Scheduled/upcoming payment notices are fetched so they can be filed as ignored.
#   "your scheduled payment",
#   # Credit-reporting alerts are fetched as structured non-spend finance records.
#   "credit report",
#   "credit score",
#   "FICO",
#   "policy renewal reminder",
#   "reservation confirmation",
# ]
#
# # Optional sender fragments to search in addition to subject keywords.
# # PayPal/Wise/Venmo/Xanterra transaction receipts often have subjects that do
# # not contain "receipt" or "invoice", so intake searches known sender hints
# # by default even when this list is left unset.
# # receipt_senders = ["service@paypal.com", "noreply@wise.com", "venmo@venmo.com", "reserve-noreply@xanterra.com"]
#
# # Local Ollama triage for ambiguous legal/payment correspondence. The model
# # can route supported non-spend documents but cannot create spending records.
# # Requires the local Ollama service at translation_base_url (default localhost:11434).
# local_classifier_enabled = true
# local_classifier_model = "llama3.2:3b-instruct-q8_0"
#
# # Optional mailboxes to scan for replies to intake's own Gmail notifications.
# # Defaults to Gmail sent-mail folders so self-addressed correction replies and
# # free-form review requests are recorded automatically.
# # reply_mailboxes = ["[Gmail]/Sent Mail"]
#
# # Raw RFC822 copies of successfully handled receipt emails are archived under
# # receipt_dir before the message is moved to the processed label.
# processed_email_dir = "email/messages"
# archive_processed_messages = true
#
# # How far back to search on each run (days)
# # Searches the first configured shock-relay IMAP mailbox (normally INBOX).
# # Built-in subjects include payment confirmations, statement and interest
# # notices; sender hints include Revolut. Only PDF attachments enter OCR.
# since_days = 90
#
# # Daemon polling interval (seconds)
# poll_interval_seconds = 300
#
# # Max emails to process per run
# limit = 500

# ── Career follow-up email (optional) ─────────────────────────────────────────
# Uses [email].shock_relay_config. The regular email fetch/daemon also scans
# these employers and the application portals (Greenhouse, Workday, Lever,
# Ashby; the employer comes from the subject) and writes each career email to
# the career repo's ignored private/intake-email/ folder with a Kind line
# (confirmation, request, screening, interview, offer, rejection). Emailed
# verification codes go to private/verification-codes/ for career's filler.
# Messages stay unread and in Inbox.
# Run: intake career fetch [--dry-run] | intake career list
#
# [career]
# repo_root = "/path/to/career"
# since_days = 30
# limit = 200
# [career.employers]
# "example.com" = "Example Employer"
# "example@myworkday.com" = "Example Employer"   # an exact portal address

# ── Signal notifications (optional) ──────────────────────────────────────────
# Sends a Signal message after a receipt is successfully processed.
#
# [signal]
# shock_relay_config = "/path/to/shock-relay/services/signal-cli/config.local.yaml"
# recipient = "+15551234567"
#
# # Or send to your own Signal "note to self" thread via signal-cli.
# # note_to_self = true
#
# # Optional explicit disable switch
# # enabled = true

# ── Gmail notifications (optional) ───────────────────────────────────────────
# Sends an email after a receipt is successfully processed.
#
# [gmail]
# recipient = "you@example.com"
#
# # Optional explicit relay config. When omitted, intake reuses
# # [email].shock_relay_config if that section is configured.
# # shock_relay_config = "/path/to/shock-relay/services/gmail-imap/config.local.yaml"
#
# # Optional subject prefix
# # subject_prefix = "[intake] "
#
# # Queue processed-receipt Gmail notices for the hourly shock-relay digest
# # instead of sending one email per receipt. Reply-link follow-ups still send
# # immediately.
# # digest = true
#
# # The initial "Receipt processed" email includes the Snowbridge File Browser
# # link when the receipt path resolves under receipt_dir.

# ── Token Metrics, Bloomberg, and Hump Days highlights (optional) ────────────
# `intake newsletter --send` uses [email].shock_relay_config and
# [gmail].recipient; a daily systemd timer can be installed with
# `intake newsletter --install-timer`.
# [newsletter]
# model = "gpt-4o-mini"
#
# # Reply to these notification emails with free-form notes or structured lines
# # like `merchant: kroger` / `total: 88.05`. Intake records the reply in
# # receipt history and applies the safe structured fields automatically.
# # Requests like "attach the OCR and image" trigger a follow-up Gmail reply
# # containing the Snowbridge File Browser link for the receipt artifact.
#
# # Optional explicit disable switch
# # enabled = true

# ── finance downstream trigger (optional) ─────────────────────────────────────
# Writes a receipts JSON batch and runs a local finance command after
# successful receipt ingestion.
#
# [personal_finance]
# repo_root = "/path/to/finance-repo"
# command = ["python3", "scripts/import_receipts.py", "{receipts_json}"]
#
# # Optional custom event spool dir (defaults to data/finance-events)
# # event_dir = "data/finance-events"
#
# # Available placeholders inside command array strings:
# #   {receipts_json}  absolute path to the generated batch JSON
# #   {receipt_count}  number of receipts in this trigger
# #   {trigger}        process | backfill | daemon | email
#
# # The command also receives:
# #   INTAKE_RECEIPTS_JSON
# #   INTAKE_RECEIPT_COUNT
# #   INTAKE_TRIGGER

# ── Purchaser name aliases (private — do not commit to public repos) ──────────
# Maps canonical purchaser names (as stored in the DB) to lists of alternate
# spellings, OCR variants, email addresses, and comma-inverted forms.
# Keep this section in your local settings.toml only.
#
# [purchaser_aliases]
# "jane sample" = [
#   "jane",
#   "jane sample",
#   "janesample",
#   "janesample@gmail.com",
#   "sample, jane",
# ]
