# Copy to config/deploy.local.env (gitignored) to choose where intake parses untrusted receipt files. Nothing here
# is required: without it, deploy/deploy.sh uses "dev". See docs/deployment.md.
#
#   dev   run the sandbox service in the foreground on this machine (no container)
#   host  the daemon parses in its own process, as intake always has
#   k3s   the sandbox in a K3s pod with no network, no secrets and no files (needs K3s, podman, the registry)
INTAKE_DEPLOY_MODE=dev
