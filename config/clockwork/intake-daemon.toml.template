[[jobs]]
name = "intake-daemon"
description = "intake receipt processor daemon"
scope = "user"
service_type = "simple"
working_directory = "%h"
exec_start = __EXEC_START__
after = ["network-online.target"]
wants = ["network-online.target"]
start_limit_interval_sec = "0"
service_install_wanted_by = ["default.target"]
restart = "always"
restart_sec = "30"
standard_output = "journal"
standard_error = "journal"

[jobs.environment]
PYTHONUNBUFFERED = "1"
