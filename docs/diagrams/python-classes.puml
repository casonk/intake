@startuml classes_intake
set namespaceSeparator none
class "Card" as intake.parse_card.Card {
  card_date : date | None
  filename : str
  message_excerpt : str
  occasion : str | None
  raw_text : str
  recipient : str | None
  scan_date : date
  sender : str | None
}
class "Document" as intake.parse_document.Document {
  body_excerpt : str
  document_date : date | None
  document_kind : str
  filename : str
  issuer : str | None
  model_number : str | None
  raw_text : str
  scan_date : date
  serial_number : str | None
  subject : str | None
  title : str | None
}
class "FetchResult" as intake.email.FetchResult {
  attachments_saved : int
  errors : int
  found : int
  html_processed : int
  reply_applied : int
  reply_processed : int
  reply_unmatched : int
  saved_files : list[Path]
  skipped : int
}
class "Letter" as intake.parse_letter.Letter {
  body_excerpt : str
  filename : str
  letter_date : date | None
  raw_text : str
  recipient : str | None
  salutation : str | None
  scan_date : date
  sender : str | None
  subject : str | None
}
class "Payment" as intake.parse_payment.Payment {
  account_last4 : str | None
  account_name : str | None
  amount : float | None
  confirmation_number : str | None
  filename : str
  payer : str | None
  payment_date : date | None
  payment_type : str | None
  raw_text : str
  scan_date : date
}
class "Receipt" as intake.parse.Receipt {
  card_last4 : str | None
  certifications : list[ReceiptCertification]
  currency : str
  filename : str
  items : list[ReceiptItem]
  language : str
  merchant : str
  purchaser : str | None
  raw_text : str
  receipt_date : date | None
  receipt_time : time | None
  scan_date : date
  staff : list[ReceiptStaff]
  total : float | None
  translated_text : str | None
  suggested_filename() -> str
}
class "ReceiptCertification" as intake.certification.ReceiptCertification {
  issuer : str
  label : str
  source_text : str | None
}
class "ReceiptItem" as intake.parse.ReceiptItem {
  amount : float | None
  description : str
  quantity : float | None
  unit_price : float | None
}
class "ReceiptLocaleHint" as intake.language.ReceiptLocaleHint {
  confidence : float
  currency : str | None
  language : str
  reasons : tuple[str, ...]
}
class "ReceiptStaff" as intake.staff.ReceiptStaff {
  name : str
  role : str
  source_text : str
}
class "RoutedDocument" as intake.document_routing.RoutedDocument {
  personal_finance_event : dict | None
  processed : bool
}
class "_ReportHandler" as intake.web._ReportHandler {
  do_GET() -> None
  do_HEAD() -> None
  log_message(fmt: str) -> None
}
class "_StripHTML" as intake.email_text._StripHTML {
  handle_data(data: str) -> None
  handle_endtag(tag: str) -> None
  handle_starttag(tag: str, attrs: list) -> None
  text() -> str
}
@enduml
