@startuml classes_intake
set namespaceSeparator none
class "FetchResult" as intake.email.FetchResult {
  attachments_saved : int
  errors : int
  found : int
  html_processed : int
  saved_files : list[Path]
  skipped : int
}
class "Receipt" as intake.parse.Receipt {
  card_last4 : str | None
  filename : str
  merchant : str
  purchaser : str | None
  raw_text : str
  receipt_date : date | None
  receipt_time : time | None
  scan_date : date
  total : float | None
  suggested_filename() -> str
}
class "_StripHTML" as intake.email._StripHTML {
  handle_data(data: str) -> None
  handle_endtag(tag: str) -> None
  handle_starttag(tag: str, attrs: list) -> None
  text() -> str
}
@enduml
